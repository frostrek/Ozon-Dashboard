# Copy this file to .env on your machine.
# On AWS, set these in the service environment. Do not commit .env.

DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ozon?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ozon?retryWrites=true&w=majority"
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
AUTH_SECRET=

GROQ_API_KEY=

# Optional. Seller accounts are stored in the database.
OZON_CLIENT_ID=
OZON_API_KEY=

# Comma-separated. The scrape uses the next key when one has no credits.
SCRAPER_API_KEY=
SCRAPER_API_KEYS=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Chrome for PDF labels. Example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
